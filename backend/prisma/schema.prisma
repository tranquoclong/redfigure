enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CommissionStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum CommissionSource {
  REFERRAL_COOKIE
  COUPON
}

enum LedgerType {
  CREDIT
  DEBIT
}

enum LedgerSource {
  COMMISSION
  MANUAL_CREDIT
  PAYMENT
  ADJUSTMENT
}

enum CommissionRuleScope {
  PRODUCT
  TAG
  CATEGORY
  GLOBAL
}

enum PaymentRequestStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model AffiliateAccount {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicId   Int     @unique @default(autoincrement())
  publicCode String? @unique @db.VarChar(32)

  status         AffiliateStatus @default(APPROVED)
  commissionRate Decimal?        @db.Decimal(5, 2)

  termsAcceptedAt DateTime
  termsVersion    String   @default("v1")

  approvedAt        DateTime?
  suspendedAt       DateTime?
  suspendedReason   String?
  suspendedByUserId String?

  notifyNewCommission  Boolean @default(false)
  notifyPaidCommission Boolean @default(false)

  lastLedgerHash    String? @db.Char(64)
  lastLedgerEntryId String?

  commissions     AffiliateCommission[]
  ledgerEntries   AffiliateLedgerEntry[]
  visits          AffiliateVisit[]
  coupons         Coupon[]
  payments        AffiliatePayment[]
  paymentRequests AffiliatePaymentRequest[]
  referredOrders  Order[]                   @relation("ReferringAffiliate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("affiliate_accounts")
}

model AffiliateVisit {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  sessionId        String?
  userId           String?
  ipHash           String?
  userAgent        String?   @db.Text
  landingUrl       String    @db.Text
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  convertedOrderId String?
  convertedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([affiliateId, createdAt])
  @@index([sessionId])
  @@index([createdAt])
  @@index([convertedOrderId])
  @@map("affiliate_visits")
}

model AffiliateCommissionRule {
  id    String              @id @default(cuid())
  scope CommissionRuleScope

  productId  String?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId      String?
  tag        Tag?      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  rate Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([scope, productId])
  @@unique([scope, tagId])
  @@unique([scope, categoryId])
  @@index([scope])
  @@map("affiliate_commission_rules")
}

model AffiliateCommissionRuleAudit {
  id              String              @id @default(cuid())
  ruleId          String?
  scope           CommissionRuleScope
  action          String
  oldRate         Decimal?            @db.Decimal(5, 2)
  newRate         Decimal?            @db.Decimal(5, 2)
  productId       String?
  tagId           String?
  categoryId      String?
  changedByUserId String
  changedAt       DateTime            @default(now())

  @@index([ruleId])
  @@index([changedByUserId, changedAt])
  @@map("affiliate_commission_rule_audits")
}

model AffiliateCommission {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  status CommissionStatus @default(PENDING)
  source CommissionSource

  baseAmount       Decimal @db.Decimal(12, 2)
  rate             Decimal @db.Decimal(5, 2)
  commissionAmount Decimal @db.Decimal(12, 2)

  approvedAt   DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntry AffiliateLedgerEntry?

  @@index([status])
  @@index([affiliateId, status])
  @@index([orderId])
  @@index([createdAt])
  @@map("affiliate_commissions")
}

model AffiliateLedgerEntry {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  type   LedgerType
  source LedgerSource
  amount Decimal      @db.Decimal(12, 2)

  orderId String?

  commissionId String?              @unique
  commission   AffiliateCommission? @relation(fields: [commissionId], references: [id])

  paymentId String?           @unique
  payment   AffiliatePayment? @relation(fields: [paymentId], references: [id])

  reason          String?
  createdByUserId String?

  prevHash String? @db.Char(64)
  hash     String? @db.Char(64)

  createdAt DateTime @default(now())

  @@index([affiliateId, createdAt])
  @@index([affiliateId, type])
  @@index([orderId])
  @@map("affiliate_ledger_entries")
}

model AffiliatePaymentRequest {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  amountRequested Decimal              @db.Decimal(12, 2)
  amountPaid      Decimal              @default(0) @db.Decimal(12, 2)
  status          PaymentRequestStatus @default(PENDING)

  requestedAt  DateTime  @default(now())
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  payments AffiliatePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateId, status])
  @@index([status, requestedAt])
  @@map("affiliate_payment_requests")
}

model AffiliatePayment {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  paymentRequestId String?
  paymentRequest   AffiliatePaymentRequest? @relation(fields: [paymentRequestId], references: [id])

  amount          Decimal  @db.Decimal(12, 2)
  note            String?
  paidAt          DateTime
  createdByUserId String

  ledgerEntry AffiliateLedgerEntry?

  createdAt DateTime @default(now())

  @@index([affiliateId, paidAt])
  @@index([paymentRequestId])
  @@map("affiliate_payments")
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
  DEFERRED
}

model EmailLog {
