// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String?
  password String
  role     UserRole @default(CUSTOMER)
  roleChangesAsTarget UserRoleChange[] @relation("UserRoleChangeTarget")
  roleChangesAsActor  UserRoleChange[] @relation("UserRoleChangeActor")
  passwordSet Boolean @default(true)

  marketingConsent Boolean @default(false)

  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?

  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  googleId      String? @unique
  googlePicture String?
  
  lastLoginAt DateTime?
  cccd   String? @unique
  phone String?
  mst                    String? @unique
  companyName             String?

  isActive Boolean @default(true)

  emailMarketingOptOut Boolean @default(false)
  unsubscribeTokenVersion Int @default(0)

  addresses        Address[]
  orders           Order[]
  wishlist         WishlistItem[]
  recentlyViewed   RecentlyViewed[]
  refreshTokens    RefreshToken[]
  loginCodes       LoginCode[]
  reviews          Review[]
  reviewInvites    ReviewInvite[]
  siteReviews      SiteReview[]
  exclusiveCoupons Coupon[]         @relation("ExclusiveCoupons")

  productQuestionsAsked    ProductQuestion[] @relation("ProductQuestionsByUser")
  productQuestionsAnswered ProductQuestion[] @relation("ProductQuestionsByAdmin")

  customQuotes CustomQuote[]

  affiliateAccount AffiliateAccount?

  cart Cart?
  emailCampaignsCreated EmailCampaign[] @relation("CampaignCreator")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

model Cart {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                Json 

  reminderSentAt       DateTime?
  secondReminderSentAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([updatedAt])
  @@map("carts")
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token      String    @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  persistent Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([token])
  @@index([familyId])
  @@map("refresh_tokens")
}

model LoginCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  purpose   String    @default("LOGIN")

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("login_codes")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

model UserRoleChange {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserRoleChangeTarget", fields: [userId], references: [id], onDelete: Cascade)
  fromRole    UserRole
  toRole      UserRole
  changedById String
  changedBy   User     @relation("UserRoleChangeActor", fields: [changedById], references: [id], onDelete: Restrict)
  reason      String?  @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([changedById])
  @@index([createdAt])
  @@map("user_role_changes")
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String? @db.VarChar(40)
  street       String
  ward         String
  district     String
  province     String
  postalCode   String?
  country      String  @default("VN")
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

model Order {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  number String      @unique
  status OrderStatus @default(PENDING)

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  reviewInvite  ReviewInvite?
  siteReview    SiteReview?

  customerName  String?
  customerEmail String?
  customerCccd   String?
  customerPhone String?

  customerMst         String?
  customerCompanyName String?

  subtotal                 Float
  shipping                 Float   @default(0)
  discount                 Float   @default(0)
  total                    Float

  shippingAddress          Json?
  shippingCarrier          String?
  shippingServiceName      String?
  shippingServiceId        Int?
  shippingDeadlineDays     Int?
  trackingCode             String?
  trackingUrl              String?
  shippingGatewayId        String?
  shippingGatewayOrderId   String?
  shippingLabelUrl         String?
  shippingGatewayStatus    ShippingGatewayStatus  @default(NONE)
  deliveredAt          DateTime?

  coupons OrderCoupon[]

  referringAffiliateId     String?
  referringAffiliate       AffiliateAccount? @relation("ReferringAffiliate", fields: [referringAffiliateId], references: [id], onDelete: SetNull)
  referringAffiliateSource CommissionSource?

  commissions AffiliateCommission[]

  paymentMethod String?
  paymentStatus PaymentStatus @default(PENDING)
  paymentId     String?

  idempotencyKey String?

  notes                 String?
  stockReserved         Boolean   @default(false)
  estimatedDeliveryDate DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@index([referringAffiliateId, createdAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum ShippingGatewayStatus  {
  NONE
  IN_CART
  PURCHASED
  GENERATED
  POSTED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  FAILED
  CANCELLED
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variationId String?
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)

  quoteItemId String?          @unique
  quoteItem   CustomQuoteItem? @relation(fields: [quoteItemId], references: [id])

  productName         String?
  productSku          String?
  productImage        String?
  productBrandName    String?
  productCategoryName String?

  customItemDescription String?
  variationLabel  String?
  variationName   String?
  scaleName       String?
  scalePercentage Float?

  quantity Int
  price    Float
  discount Float @default(0)

  isFreeGift Boolean @default(false)

  parentOrderItemId String?
  parentOrderItem   OrderItem?  @relation("BundleOrderItems", fields: [parentOrderItemId], references: [id], onDelete: Cascade)
  childOrderItems   OrderItem[] @relation("BundleOrderItems")
  bundleDiscount    Float?

  commission AffiliateCommission?

  createdAt DateTime @default(now())

  @@index([parentOrderItemId])
  @@index([quoteItemId])
  @@map("order_items")
}

model Product {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  description      String
  shortDescription String?
  content          String?
  type             String  @default("simple")

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  basePrice    Float
  salePrice    Float?
  displayPrice Float  @default(0)

  bundleDiscount Float?

  sku                String?         @unique
  gtin               String?
  mpn                String?
  condition          String          @default("new")
  colorId            String?
  color              Color?          @relation(fields: [colorId], references: [id], onDelete: SetNull)
  materialId         String?
  material           Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  googleCategoryId   String?
  googleCategory     GoogleCategory? @relation("ProductGoogleCategory", fields: [googleCategoryId], references: [id], onDelete: SetNull)
  salePriceStartDate DateTime?
  salePriceEndDate   DateTime?
  manageStock        Boolean         @default(true)
  stock              Int             @default(0)
  reservedStock      Int             @default(0)
  lowStockThreshold  Int?
  weight             Float?
  width              Float?
  height             Float?
  length             Float?
  extraDays          Int?
  scaleRuleSetId     String?
  scaleRuleSet       ScaleRuleSet? @relation(fields: [scaleRuleSetId], references: [id], onDelete: SetNull)
  noScales           Boolean       @default(false)

  isDraft  Boolean @default(false)
  isActive Boolean @default(true)
  featured Boolean @default(false)

  salesCount Int @default(0)

  tags              Tag[]              @relation("ProductToTag")
  variations        ProductVariation[]
  images            ProductImage[]
  attributes        ProductAttribute[]
  relatedProducts   RelatedProduct[]   @relation("ProductRelated")
  reviews           Review[]
  stockAuditLogs    StockAuditLog[]
  productCategories ProductCategory[]
  questions         ProductQuestion[]

  bundleComponents BundleComponent[] @relation("BundleParent")
  bundleParentOf   BundleComponent[] @relation("BundleChild")

  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  recentlyViewed RecentlyViewed[]
  freeGifts      FreeGift[]

  commissionRules AffiliateCommissionRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([slug])
  @@index([displayPrice])
  @@index([salesCount])
  @@map("products")
}

model ProductVariation {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name String

  attributeValueId String?
  attributeValue   AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)

  sku           String  @default("")
  gtin          String?
  price         Float
  salePrice     Float?
  manageStock   Boolean @default(true)
  stock         Int     @default(0)
  reservedStock Int     @default(0)
  image         String?
  weight        Float?
  width         Float?
  height        Float?
  length        Float?

  orderItems       OrderItem[]
  stockAuditLogs   StockAuditLog[]
  bundleComponents BundleComponent[]
  images           ProductVariationImage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([attributeValueId])
  @@map("product_variations")
}

model ProductVariationImage {
  id          String           @id @default(cuid())
  variationId String
  variation   ProductVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  mediaFileId String
  mediaFile   MediaFile        @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  order  Int     @default(0)
  isMain Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([variationId])
  @@map("product_variation_images")
}

model MediaFile {
  id       String @id @default(cuid())
  filename String
  mimeType String
  size     Int

  thumb    String
  card     String
  gallery  String
  full     String
  original String?

  alt         String?
  title       String?
  description String?
  caption String?

  captionPresetId String?
  captionPreset   MediaCaptionPreset? @relation(fields: [captionPresetId], references: [id], onDelete: SetNull)
  width  Int?
  height Int?

  productImages          ProductImage[]
  productVariationImages ProductVariationImage[]
  customQuoteImages      CustomQuoteImage[]

  whitelistedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([whitelistedAt])
  @@map("media_files")
}

model MediaCaptionPreset {
  id   String @id @default(cuid())
  name String @unique
  text String @db.Text

  order Int @default(0)

  mediaFiles MediaFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("media_caption_presets")
}

model ProductImage {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaFileId String
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  order  Int     @default(0)
  isMain Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  image       String?

  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToCategory")

  productCategories ProductCategory[] @relation("ProductCategoryRelation")
  featuredCategory  FeaturedCategory?
  coupons           Coupon[]

  commissionRules AffiliateCommissionRule[]

  scaleRuleSetId String?
  scaleRuleSet   ScaleRuleSet? @relation(fields: [scaleRuleSetId], references: [id], onDelete: SetNull)

  colorId          String?
  color            Color?          @relation(fields: [colorId], references: [id], onDelete: SetNull)
  materialId       String?
  material         Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  googleCategoryId String?
  googleCategory   GoogleCategory? @relation("CategoryGoogleCategory", fields: [googleCategoryId], references: [id], onDelete: SetNull)

  isActive  Boolean @default(true)
  extraDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@map("categories")
}

model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation("ProductCategoryRelation", fields: [categoryId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_categories")
}

model Tag {
  id    String  @id @default(cuid())
  name  String  @unique
  slug  String  @unique
  color String?

  products Product[] @relation("ProductToTag")
  coupons  Coupon[]

  commissionRules AffiliateCommissionRule[]

  scaleRuleSetId String?
  scaleRuleSet   ScaleRuleSet? @relation(fields: [scaleRuleSetId], references: [id], onDelete: SetNull)
  noScales       Boolean       @default(false)

  isActive  Boolean @default(true)
  extraDays Int?

  createdAt DateTime @default(now())

  @@index([slug])
  @@map("tags")
}

model Brand {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  logo        String?
  description String?

  skuPrefix           String? @map("sku_prefix")
  renameFolderDefault Boolean @default(true) @map("rename_folder_default")

  scaleRuleSetId String?       @map("scale_rule_set_id")
  scaleRuleSet   ScaleRuleSet? @relation(fields: [scaleRuleSetId], references: [id], onDelete: SetNull)
  noScales       Boolean       @default(false) @map("no_scales")

  products   Product[]
  skuCounter SkuCounter?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@map("brands")
}

model SkuCounter {
  id        String   @id @default(cuid())
  brandId   String   @unique @map("brand_id")
  counter   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id])

  @@map("sku_counters")
}

model ScaleRuleSet {
  id   String @id @default(cuid())
  name String @unique

  items      ScaleRuleItem[]
  products   Product[]
  tags       Tag[]
  brands     Brand[]
  categories Category[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("scale_rule_sets")
}

model ScaleRuleItem {
  id        String       @id @default(cuid())
  ruleSetId String
  ruleSet   ScaleRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  name               String
  percentageIncrease Float  @default(0)
  sortOrder          Int    @default(0)

  @@unique([ruleSetId, name])
  @@map("scale_rule_items")
}

model Coupon {
  id   String     @id @default(cuid())
  code String     @unique
  type CouponType

  value         Float
  minOrderValue Float?
  maxUses       Int?
  usesPerUser   Int? 

  validFrom  DateTime?
  validUntil DateTime?

  isFirstPurchaseOnly Boolean @default(false)
  isFreeShipping      Boolean @default(false)
  isActive            Boolean @default(true)
  stackable            Boolean  @default(false)
  stackableWith        Coupon[] @relation("CouponStackable")
  stackableWithInverse Coupon[] @relation("CouponStackable")

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  tagId      String?
  tag        Tag?      @relation(fields: [tagId], references: [id])
  userId     String?
  user       User?     @relation("ExclusiveCoupons", fields: [userId], references: [id])

  affiliateId String?
  affiliate   AffiliateAccount? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  allowedEmail String?

  usages            CouponUsage[]
  reviewRewards     ReviewReward[]
  reviewInvite      ReviewInvite?
  orderCoupons      OrderCoupon[]
  newsletterGiftLog NewsletterGiftLog?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([affiliateId])
  @@map("coupons")
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model OrderCoupon {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  couponId   String
  coupon     Coupon @relation(fields: [couponId], references: [id])
  discount   Float
  couponType String
  position   Int    @default(0)

  createdAt DateTime @default(now())

  @@unique([orderId, couponId])
  @@index([orderId])
  @@map("order_coupons")
}

model CouponUsage {
  id       String  @id @default(cuid())
  couponId String
  coupon   Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String
  orderId  String?

  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

model FreeShippingTier {
  id          String  @id @default(cuid())
  shippingUpTo Int?
  minSubtotal Int
  extraDays   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("free_shipping_tiers")
}

model FreeGift {
  id             String    @id @default(cuid())
  isActive       Boolean   @default(true)
  minOrderAmount Float
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  startsAt       DateTime?
  endsAt         DateTime?
  label          String    @default("🎁 Quà tặng!")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([productId])
  @@map("free_gifts")
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus String?
  toStatus   String
  notes      String?
  createdBy  String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model BundleComponent {
  id               String            @id @default(cuid())
  parentProductId  String
  parentProduct    Product           @relation("BundleParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  childProductId   String
  childProduct     Product           @relation("BundleChild", fields: [childProductId], references: [id], onDelete: Cascade)
  childVariationId String?
  childVariation   ProductVariation? @relation(fields: [childVariationId], references: [id], onDelete: SetNull)
  quantity         Int               @default(1)
  sortOrder        Int               @default(0)

  createdAt DateTime @default(now())

  @@unique([parentProductId, childProductId, childVariationId])
  @@index([parentProductId])
  @@map("bundle_components")
}

model Bundle {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  discount    Float

  items BundleItem[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@map("bundles")
}

model BundleItem {
  id        String @id @default(cuid())
  bundleId  String
  bundle    Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String

  quantity Int @default(1)

  createdAt DateTime @default(now())

  @@unique([bundleId, productId])
  @@map("bundle_items")
}

model Payment {
  id      String        @id @default(cuid())
  orderId String
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method  String
  gateway String        @default("sepay")
  status  PaymentStatus @default(PENDING)

  externalId  String?   @unique
  amount      Float
  discount    Float     @default(0)
  paidAmount  Float?
  paidAt      DateTime?
  webhookData String?

  redirectUrl   String?
  expiresAt     DateTime?
  installments  Int?
  cardLastFour  String?

  events PaymentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([externalId])
  @@map("payments")
}

model PaymentEvent {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId   String

  type                String
  rawData             Json
  gatewayStatus       String? @map("gateway_status")
  gatewayStatusDetail String? @map("gateway_status_detail")

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([orderId])
  @@index([createdAt])
  @@map("payment_events")
}

model StockAuditLog {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variationId String?
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: Cascade)

  quantityBefore Int
  quantityAfter  Int
  delta          Int
  reservedBefore Int?
  reservedAfter  Int?

  reason      String
  referenceId String?
  note        String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variationId])
  @@index([createdAt])
  @@index([productId, createdAt(sort: Desc)])
  @@map("stock_audit_logs")
}

model CheckoutLog {
  id        String   @id @default(cuid())
  orderId   String?
  userId    String?
  step      String
  status    String
  method    String?
  request   String?  @db.Text
  response  String?  @db.Text
  error     String?  @db.Text
  duration  Int?
  ip        String?
  userAgent String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([userId])
  @@index([step])
  @@index([createdAt])
  @@map("checkout_logs")
}

model SeoMeta {
  id          String  @id @default(cuid())
  entityType  String
  entityId    String
  title       String?
  description String?
  ogImage     String?
  keywords    String?
  canonical   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId])
  @@map("seo_meta")
}

model BlogPost {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  excerpt     String?
  content     String
  coverImage  String?
  authorId    String
  isPublished Boolean @default(false)
  featured    Boolean @default(false)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@map("blog_posts")
}

model Page {
  id      String @id @default(cuid())
  title   String
  slug    String @unique
